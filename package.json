{
  "name": "mrshkn-demos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.9.4",
  "engines": {
    "node": "24.x"
  },
  "volta": {
    "node": "24.15.0",
    "yarn": "4.9.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "demo:new": "node scripts/demo-new.ts",
    "dev": "yarn workspace @mrshkn/demo-template dev -p 3300",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && yarn workspaces foreach --all --exclude mrshkn-demos run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "test": "yarn typecheck && yarn lint && yarn format:check && yarn test:unit && yarn test:integration && yarn test:e2e"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.5.0",
    "@types/pg": "8.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.5",
    "happy-dom": "^20.0.0",
    "pg": "8.20.0",
    "prettier": "^3.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sass": "^1.93.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
