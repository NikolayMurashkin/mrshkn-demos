DATABASE_URL=postgres://demos:demos@127.0.0.1:5435/demos_expert
PAYLOAD_SECRET=
# production — демо открыто поиску (только после публикации сайта студии); любое другое значение или пусто — noindex
# DEMO_ENV=
# Уведомление об оплаченной записи в Telegram: бот и чаты через запятую. Без них запись только сохраняется в CMS.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_IDS=
# Адрес API Telegram; в тестах — приемник вместо api.telegram.org.
# TELEGRAM_API_URL=
# Тестовый магазин ЮKassa: идентификатор магазина и секретный ключ. Без них запись с оплатой отвечает 502.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# Адрес API ЮKassa, по умолчанию https://api.yookassa.ru; в тестах — приемник.
# YOOKASSA_API_URL=
# Только в образе и у e2e-сервера: миграции Payload при старте. На базе разработки не включать.
# MIGRATE_ON_START=true
