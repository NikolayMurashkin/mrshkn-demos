PAYLOAD_SECRET=
# production — демо открыто поиску (только после публикации сайта студии); любое другое значение или пусто — noindex
# DEMO_ENV=
# Уведомление о заявке в Telegram: бот и чаты через запятую. Без них заявка только сохраняется в CMS.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_IDS=
# Адрес API Telegram; в тестах — приемник вместо api.telegram.org.
# TELEGRAM_API_URL=
# Только в образе и у e2e-сервера: миграции Payload при старте. На базе разработки не включать.
# MIGRATE_ON_START=true
