{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@/*": ["./apps/template/src/*"],
      "@payload-config": ["./apps/template/src/payload.config.ts"]
    },
    "allowJs": true
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "tests/**/*.tsx", "*.config.ts", "packages/core/src/scss.d.ts"],
  "exclude": ["node_modules"]
}
